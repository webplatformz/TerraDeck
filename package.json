{
  "name": "terradeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Find every country on the map, earn Visitor and Explorer stamps, collect the atlas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "rarity:build": "node scripts/build-rarity.mjs",
    "rarity:collect": "node scripts/collect-rarity.mjs",
    "atlas:collect": "node scripts/collect-atlas.mjs",
    "atlas:build": "node scripts/build-atlas.mjs && npm run rarity:build && npm run geo:build",
    "geo:build": "node scripts/build-geo.mjs",
    "details:collect": "node scripts/collect-country-details.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "flag-icons": "^7.6.0",
    "i18next": "^26.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
